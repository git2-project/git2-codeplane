# Copy to .env and fill in. Real environment variables override this file.
# .env is gitignored: it holds the shared dev DB password. Never commit it.

# ── PostgreSQL (shared dev DB) ────────────────────────────────────────────────
# The same connection string as POSTGRES_DSN in the git2 repo. Our tables live
# in the git_svc schema, created by the git2 repo's migrations.
# Until you have the shared DB's credentials, the devcontainer's test database
# works too (its schema comes from this repo's copy of the migrations):
#   postgres://git2:git2@postgres:5432/git2_test?sslmode=disable
POSTGRES_DSN=
POSTGRES_MAX_CONNS=10

# Throwaway database for the Postgres integration tests. The devcontainer sets
# it to its own postgres service. Never point it at the shared dev DB.
TEST_POSTGRES_DSN=

# ── git-svc ───────────────────────────────────────────────────────────────────
GIT2_GITSVC_GRPC_ADDR=:9090
# Absolute path that holds the repositories. The devcontainer sets it to a
# Docker volume (/var/lib/git-svc).
GIT2_STORAGE_ROOT=
# true enables gRPC reflection, which grpcurl needs. Never in production.
GIT2_GITSVC_DEV=true
GIT2_GITSVC_LOG_LEVEL=info
